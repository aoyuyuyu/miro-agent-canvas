{
  "name": "agent-relay-prototype",
  "private": true,
  "version": "0.8.0",
  "description": "Miro：中文 Agent 聊天与会话接力",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env MIRO_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "dev:mock": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env MIRO_DEV_URL=http://127.0.0.1:5173 MIRO_MOCK=1 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "start:built": "electron .",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "build:vendor": "node scripts/build-vendor.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "@xyflow/react": "12.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "44.5.1",
    "wait-on": "9.5.1"
  }
}
